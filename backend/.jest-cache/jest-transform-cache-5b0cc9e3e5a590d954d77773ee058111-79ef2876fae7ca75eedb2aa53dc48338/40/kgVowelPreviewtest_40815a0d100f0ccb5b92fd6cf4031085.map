import { gradeKGVowelTranscript, KG_VOWEL_TARGETS } from '../../src/controllers/kg-vowel-preview.controller'

describe('KG Level 6 vowel preview grading', () => {
  it('uses the approved target order and words', () => {
    expect(KG_VOWEL_TARGETS.map(({ letter, word }) => `${letter}-${word}`)).toEqual([
      'A-apple', 'E-elephant', 'I-igloo', 'O-orange', 'U-umbrella',
    ])
  })

  it('accepts only the exact expected word after basic punctuation normalization', () => {
    expect(gradeKGVowelTranscript(' Apple! ', 'apple')).toBe('correct')
    expect(gradeKGVowelTranscript('orange', 'apple')).toBe('incorrect')
    expect(gradeKGVowelTranscript('apple please', 'apple')).toBe('incorrect')
  })

  it('treats blank or uncertain speech as unclear', () => {
    expect(gradeKGVowelTranscript('', 'apple')).toBe('unclear')
    expect(gradeKGVowelTranscript('apple', 'apple', true)).toBe('unclear')
    expect(gradeKGVowelTranscript('apple', 'apple', false, 0.2)).toBe('unclear')
  })
})
