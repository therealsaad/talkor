  "lines": [
    {
      "id": "listen-at",
      "language": "en-IN",
      "text": "Listen carefully. Which word is at? At.",
      "s3Key": "class-01/level-01/v1/listen-at.wav"
    },
    {
      "id": "build-at",
      "language": "en-IN",
      "text": "Let us build the word at. A, T, at.",
      "s3Key": "class-01/level-01/v1/build-at.wav"
    },
    {
      "id": "listen-in",
      "language": "en-IN",
      "text": "Listen carefully. Which word is in? In.",
      "s3Key": "class-01/level-01/v1/listen-in.wav"
    },
    {
      "id": "build-in",
      "language": "en-IN",
      "text": "Let us build the word in. I, N, in.",
      "s3Key": "class-01/level-01/v1/build-in.wav"
    },
    {
      "id": "look-at-me",
      "language": "en-IN",
      "text": "Look at me. Which word is missing?",
      "s3Key": "class-01/level-01/v1/look-at-me.wav"
    },
    {
      "id": "i-am-sam",
      "language": "en-IN",
      "text": "Let us make a sentence. I am Sam.",
      "s3Key": "class-01/level-01/v1/i-am-sam.wav"
    },
    {
      "id": "try-again",
      "language": "en-IN",
      "text": "Good try. Listen again and have another go.",
      "s3Key": "class-01/level-01/v1/try-again.wav"
    },
    {
      "id": "well-done",
      "language": "en-IN",
      "text": "Wonderful! You did it.",
      "s3Key": "class-01/level-01/v1/well-done.wav"
    },
    {
      "id": "homework",
      "language": "en-IN",
      "text": "Your homework: say I am Sam and Look at me with someone at home.",
      "s3Key": "class-01/level-01/v1/homework.wav"
    },
    {
      "id": "repeat-at",
      "language": "en-IN",
      "text": "You built a little word! Say at with me. At! You can try again, beta ji.",
      "s3Key": "class-01/level-01/v1/repeat-at.wav"
    },
    {
      "id": "say-walk",
      "language": "en-IN",
      "text": "Now we are going to school. Look, I am walking! Walk, walk. Can you say walk, beta ji?",
      "s3Key": "class-01/level-01/v1/say-walk.wav"
    },
    {
      "id": "find-school",
      "language": "en-IN",
      "text": "Look around our little garden. Can you find the school? Say school or point to it.",
      "s3Key": "class-01/level-01/v1/find-school.wav"
    },
    {
      "id": "school-talk",
      "language": "en-IN",
      "text": "Wonderful! Tell me one small thing you like to do at school. You may start with: I play.",
      "s3Key": "class-01/level-01/v1/school-talk.wav"
    },
    {
      "id": "homework-first-day",
      "language": "en-IN",
      "text": "Today you learnt little words and talked about school. At home, show someone your best school walk and say: I walk to school.",
      "s3Key": "class-01/level-01/v1/homework-first-day.wav"
    }
  ]
}
