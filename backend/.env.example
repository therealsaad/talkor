NODE_ENV=development
PORT=5000

# Use the MongoDB Atlas URI from your deployment. Do not replace it with localhost.
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/talkora?retryWrites=true&w=majority
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d

# Optional exact Student _id allowlist for KG pilot accounts. Empty means no pilot access.
KG_PILOT_STUDENT_IDS=

CLIENT_URL=http://localhost:3000
CLIENT_URLS=

# Student conversations use this selected provider. The API key must be valid.
AI_PROVIDER=groq
GROQ_API_KEY=
CONVERSATION_GROQ_MODEL=openai/gpt-oss-20b
GROQ_MODEL=qwen/qwen3.6-27b

# Groq remains optional for conversational AI and legacy STT fallback.
GROQ_STT_MODEL=whisper-large-v3-turbo
GROQ_STT_ACCURATE_MODEL=whisper-large-v3
GROQ_STT_LANGUAGE=
# No KG-specific STT variable is necessary: SPEECH_PROVIDER applies to all grades.
# KG_ALPHABET_STT_PROVIDER=groq  # legacy override only
STT_TIMEOUT_MS=18000

# Gemini is used only by Gemini-specific tools, such as educator AI.
GEMINI_API_KEY=
GEMINI_MODEL=
GEMINI_FALLBACK_MODEL=
OPENAI_API_KEY=
OPENAI_MODEL=
QWEN_API_KEY=
QWEN_API_BASE=
QWEN_MODEL=

AI_SERVICE_URL=http://127.0.0.1:8001
AI_SERVICE_API_KEY=
AI_SERVICE_TIMEOUT_MS=16000

TTS_TIMEOUT_MS=12000
TTS_VOICE_ID=priya
TTS_LOGIN_PREWARM_MAX_LINES=10
VOICE_PREWARM_REQUEST_TIMEOUT_MS=12000

# Fixed curriculum uses reviewed S3 audio; dynamic new responses use Azure.
VOICE_PROVIDER=azure
CONVERSATION_VOICE_PROVIDER=azure
SPEECH_PROVIDER=sarvam
PRONUNCIATION_PROVIDER=python
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=centralindia
AZURE_SPEECH_STT_LOCALE=en-IN
AZURE_SPEECH_VOICE=en-IN-NeerjaNeural
AZURE_SPEECH_RATE=-8%
AZURE_SPEECH_PITCH=+2%

GROQ_TTS_MODEL=canopylabs/orpheus-v1-english
GROQ_TTS_VOICE=diana
GROQ_TTS_MAX_CHARS=200

INDICF5_SERVICE_URL=
INDICF5_API_KEY=
INDICF5_TIMEOUT_MS=20000
VOICE_WARMUP_ENABLED=false
VOICE_WARMUP_MAX_ITEMS=10
VOICE_WARMUP_TIMEOUT_MS=180000

SARVAM_API_KEY=
SARVAM_TTS_MODEL=bulbul:v3
SARVAM_TTS_SPEAKER=ishita
SARVAM_TTS_LANGUAGE=en-IN
SARVAM_TTS_PACE=0.92
SARVAM_TTS_TEMPERATURE=0.6
SARVAM_STT_MODEL=saaras:v4
# unknown detects English/Hindi/Marathi; codemix preserves English vocabulary.
SARVAM_STT_LANGUAGE=unknown
SARVAM_STT_MODE=codemix
SARVAM_TIMEOUT_MS=15000

SEED_SCHOOL_CODE=DEMO001
SEED_SCHOOL_PASSWORD=replace-for-local-development
SEED_TEACHER_EMAIL=teacher@demo.talkora.dev
SEED_TEACHER_PASSWORD=replace-for-local-development

KG_VOICE_PROVIDER=s3
# KG uses approved AI4Bharat Priya S3 lesson AND feedback clips. Produce/upload
# new manifest lines before pilot rollout. S3 mode fails visibly for missing clips.
# KG_VOICE_PROVIDER=azure is an explicit temporary fallback ONLY, not a cache.
KG_AZURE_SPEECH_RATE=+5%
KG_AZURE_SPEECH_PITCH=+6%
